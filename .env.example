# Signal-to-Shock configuration template. Copy to .env (never commit .env).
# The offline replay demo needs NO keys: `python run_demo.py` works with this file absent.

# Engine mode: true = deterministic offline replay from committed caches (default).
# Live mode needs the keys below plus `pip install -r requirements-live.txt`.
OFFLINE_MODE=true

# News ingestion (live pull only)
NEWSAPI_KEY=

# LLM extraction (live mode only)
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# LLM budget and throttling
MAX_LLM_CALLS=150
LLM_MAX_RPM=4

# Server port
API_PORT=8000
