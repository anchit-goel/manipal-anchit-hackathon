# Signal-to-Shock Configuration Template

# Ingestion Keys
NEWSAPI_KEY=your_newsapi_key_here

# LLM Providers (for structured extraction in Phase 2)
# Supported: gemini, openai, anthropic, or offline mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Engine Operation Mode
# Set OFFLINE_MODE=true for 100% deterministic local replay without internet/API calls
OFFLINE_MODE=true

# Server & Dashboard Ports
API_PORT=8000
STREAMLIT_PORT=8501
